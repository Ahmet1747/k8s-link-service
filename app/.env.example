# Uygulama ortam değişkenleri örneği.
# GERÇEK şifreleri buraya YAZMAYIN; bu dosya sadece örnektir (.env repoya girmez).

# Yerel/test (varsayılan): SQLite — kurulum gerektirmez
# DATABASE_URL=sqlite:///./urls.db

# Postgres (docker-compose / prod-benzeri):
DATABASE_URL=postgresql+psycopg2://appuser:changeme@db:5432/urls
